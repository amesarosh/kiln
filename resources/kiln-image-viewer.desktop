[Desktop Entry]
Type=Application
Name=Image Viewer
Comment=Look at pictures, and flip through the others in the same folder
Exec=kiln-image-viewer %f
Icon=image-viewer
Categories=Graphics;Viewer;2DGraphics;RasterGraphics;
Keywords=image;picture;photo;viewer;png;jpeg;gif;svg;
MimeType=image/png;image/apng;image/jpeg;image/webp;image/gif;image/bmp;image/x-bmp;image/tiff;image/x-icon;image/vnd.microsoft.icon;image/x-tga;image/x-portable-anymap;image/x-portable-bitmap;image/x-portable-graymap;image/x-portable-pixmap;image/qoi;image/svg+xml;
OnlyShowIn=kiln;
StartupWMClass=kiln-image-viewer
